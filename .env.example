# ==============================================================================
# Orbinest Studio - Environment Variables Reference (.env.example)
# ==============================================================================

# Production Site URL (used for canonical URLs, OpenGraph, sitemap, and robots)
NEXT_PUBLIC_SITE_URL="https://orbinest.com"

# Agency WhatsApp Number (Country code + 10 digits without '+' or dashes)
# Example for India: 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER="91XXXXXXXXXX"

# Optional: Email & Lead Notification Services
# RESEND_API_KEY="re_123456789"
# NOTIFICATION_EMAIL="hello@orbinest.com"

# Optional: Supabase Database Integration
# NEXT_PUBLIC_SUPABASE_URL="https://xyzcompany.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
# SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."
